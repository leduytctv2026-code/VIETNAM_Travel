# Máy phát triển: npm run setup:dev tự tạo .env với khóa ngẫu nhiên.
NODE_ENV=development
PORT=5000
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>/vietnam_heritage?retryWrites=true&w=majority
DATABASE_URL=
# Optional when the local DNS resolver times out on Atlas SRV records.
# Example: MONGO_DNS_SERVERS=1.1.1.1,8.8.8.8
MONGO_DNS_SERVERS=
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
FRONTEND_URL=http://localhost:3000
# Chỉ dùng cho backend Express chạy riêng ở local. Trên Vercel hãy bỏ biến này.
API_INTERNAL_URL=http://localhost:5000
# Chỉ tăng khi triển khai sau proxy đáng tin; Vercel tự dùng giá trị 1.
TRUST_PROXY_HOPS=0
# Vercel không có ổ đĩa lưu trữ bền vững; production upload phải dùng s3.
MEDIA_PROVIDER=local
MEDIA_ROOT=.local/media
S3_REGION=ap-southeast-1
S3_BUCKET=
# Bỏ trống khi dùng AWS IAM role; endpoint chỉ dùng cho S3-compatible storage.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Turnstile tùy chọn: phải cấu hình cả secret và site key.
CAPTCHA_SECRET=
CAPTCHA_SITE_KEY=
# Optional OAuth. Do not expose these secrets with a NEXT_PUBLIC_ prefix.
# Register these exact local callback URLs with Google and Meta:
# http://localhost:3000/api/v1/auth/google/callback
# http://localhost:3000/api/v1/auth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Chỉ dùng khi khởi tạo; không ghi đè mật khẩu admin đã tồn tại.
SEED_ADMIN_EMAIL=editor@example.com
SEED_ADMIN_PASSWORD=replace-with-unique-password-12-characters-minimum
