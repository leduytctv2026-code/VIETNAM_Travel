{
  "name": "vietnam-unfolded",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch backend/src/server.ts",
    "dev:web": "next dev --hostname 0.0.0.0",
    "setup:dev": "tsx scripts/setup-dev.ts",
    "seed": "tsx scripts/seed.ts",
    "db:indexes": "tsx scripts/indexes.ts",
    "test:e2e": "playwright test",
    "build": "npm run build:api && next build",
    "build:api": "tsc -p backend/tsconfig.json",
    "start": "concurrently -k -n api,web \"node backend/dist/server.js\" \"next start --hostname 0.0.0.0\"",
    "typecheck": "tsc --noEmit && tsc -p backend/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:backend": "vitest run backend/tests",
    "test:frontend": "vitest run tests/frontend",
    "lint": "eslint src backend/src shared scripts tests --max-warnings 0",
    "format": "prettier --write src backend/src shared scripts tests *.json *.md"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@hookform/resolvers": "^5.9.1",
    "bcryptjs": "^3.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "framer-motion": "^12.0.0",
    "gsap": "^3.15.0",
    "helmet": "^8.3.0",
    "jose": "^6.0.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lenis": "^1.3.26",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.19.0",
    "multer": "^2.4.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.88.0",
    "sharp": "^0.35.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.0",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "jsdom": "^29.1.1",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
